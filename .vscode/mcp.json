{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "lucid-icon": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "lucide-mcp"]
    },
    "drawio": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@drawio/mcp"]
    },
    "excalidraw": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "excalidraw-mcp"]
    }
  }
}