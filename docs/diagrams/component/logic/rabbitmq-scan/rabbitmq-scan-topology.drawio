<mxfile host="app.diagrams.net" modified="2026-09-19T00:00:00.000Z" agent="SecureFilesAgent" version="24.7.17">
  <diagram id="rabbitmq-scan-topology" name="RabbitMQ scan topology">
    <mxGraphModel dx="2200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SecureFiles - RabbitMQ scan topology (detailed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="scope-note" value="RabbitMQ transporte les demandes de scan, mais le domaine reste la source de verite : le listener ACK seulement apres le traitement persistant ou apres une action DLQ complete." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=14;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="2050" height="55" as="geometry" />
        </mxCell>

        <mxCell id="outbox-db" value="PostgreSQL&#xa;Outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="relay" value="OutboxRabbitMqRelay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="280" y="190" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="exchange" value="RabbitMQ exchange&#xa;securefiles.scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#831843;" vertex="1" parent="1"><mxGeometry x="580" y="190" width="230" height="90" as="geometry" /></mxCell>

        <mxCell id="main-queue" value="QUEUE&#xa;securefiles.scan&#xa;route: file.scan.requested" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="910" y="120" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="retry-queue" value="QUEUE RETRY&#xa;securefiles.scan.retry&#xa;TTL: scan.retry-delay" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="910" y="330" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="dlq" value="QUEUE DLQ&#xa;securefiles.scan.dlq&#xa;transport exhaustion" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#be123c;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="1250" y="540" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="poison" value="QUEUE POISON&#xa;securefiles.scan.poison&#xa;manual analysis" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="910" y="750" width="220" height="110" as="geometry" /></mxCell>

        <mxCell id="scan-listener" value="RabbitMqScanListener&#xa;manual ACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="dlq-listener" value="RabbitMqDeadLetterListener&#xa;redrive counter / FailScan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#be123c;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="scan-usecase" value="ScanFileUseCase&#xa;claim, stream, verdict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1580" y="120" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="status-db" value="PostgreSQL&#xa;status + ScanAttempt" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="1580" y="330" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="minio" value="MinIO quarantine&#xa;private octet stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="1850" y="540" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="clamav" value="ClamAV&#xa;INSTREAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1850" y="750" width="220" height="110" as="geometry" /></mxCell>

        <mxCell id="e-01" value="read pending event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#7c3aed;fontSize=12;" edge="1" parent="1" source="outbox-db" target="relay"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-02" value="publish + publisher confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#16a34a;fontSize=12;" edge="1" parent="1" source="relay" target="exchange"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="exchange" target="main-queue"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-04" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="main-queue" target="scan-listener"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-05" value="scan(command)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#16a34a;fontSize=12;" edge="1" parent="1" source="scan-listener" target="scan-usecase"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-06" value="persist status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#7c3aed;fontSize=12;" edge="1" parent="1" source="scan-usecase" target="status-db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-07" value="open private stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="scan-usecase" target="minio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-08" value="INSTREAM verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#dc2626;fontSize=12;" edge="1" parent="1" source="minio" target="clamav"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-09" value="ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="scan-listener" target="main-queue"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e-10" value="NACK -> retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="main-queue" target="retry-queue"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-11" value="retry TTL -> exchange" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="retry-queue" target="exchange"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-12" value="transport retries exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#be123c;fontSize=11;" edge="1" parent="1" source="scan-listener" target="dlq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#be123c;fontSize=12;" edge="1" parent="1" source="dlq" target="dlq-listener"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-14" value="redrive if below limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#be123c;fontSize=11;" edge="1" parent="1" source="dlq-listener" target="exchange"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-15" value="redrive -> main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="exchange" target="main-queue"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-17" value="missing correlation -> poison" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#4b5563;fontSize=11;" edge="1" parent="1" source="dlq-listener" target="poison"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;html=1;endArrow=classic;strokeColor=#be123c;fontSize=11;" edge="1" parent="1" source="dlq-listener" target="dlq"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note-ack" value="ACK manual : le broker retire le message de la queue consommee.&#xa;NACK requeue=false : la queue applique son dead-letter exchange.&#xa;Une publication non confirmee ou un echec de traitement reste reessayable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="800" height="110" as="geometry" /></mxCell>
        <mxCell id="note-domain" value="Regle metier : seul CLEAN rend le fichier telechargeable.&#xa;Les octets circulent entre MinIO et ClamAV ; PostgreSQL conserve les metadonnees, statuts et tentatives." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="900" y="970" width="900" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
