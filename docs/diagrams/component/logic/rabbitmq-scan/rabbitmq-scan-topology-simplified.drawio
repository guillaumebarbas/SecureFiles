        <mxCell id="e-10" value="invalid correlation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#4b5563;fontSize=12;" edge="1" parent="1" source="dlq-listener" target="poison"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-11" value="FailScan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#7c3aed;fontSize=12;" edge="1" parent="1" source="dlq-listener" target="database"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="ACK manuel apres traitement.&#xa;NACK requeue=false utilise le dead-letter de la queue.&#xa;Seul CLEAN rend le fichier disponible." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1550" height="85" as="geometry" /></mxCell>
