        <mxCell id="e-01" value="publish confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#16a34a;fontSize=12;" edge="1" parent="1" source="outbox" target="exchange"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-02" value="route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="exchange" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="main" target="listener"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-04" value="scan + verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="listener" target="usecase"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-05" value="persist status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#7c3aed;fontSize=12;" edge="1" parent="1" source="usecase" target="database"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-06" value="ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;html=1;endArrow=classic;strokeColor=#2563eb;fontSize=12;" edge="1" parent="1" source="listener" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-07" value="NACK -> retry TTL -> main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#d97706;fontSize=12;" edge="1" parent="1" source="main" target="retry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-08" value="transport limit -> DLQ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#be123c;fontSize=12;" edge="1" parent="1" source="listener" target="dlq"><mxGeometry relative="1" as="geometry" /></mxCell>
