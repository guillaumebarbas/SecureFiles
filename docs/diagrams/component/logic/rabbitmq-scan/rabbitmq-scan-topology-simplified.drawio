        <mxCell id="title" value="SecureFiles - RabbitMQ scan topology (simplified)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="scope-note" value="Une demande de scan suit la boucle queue principale -> retry TTL -> queue principale. Les redeliveries depassees vont en DLQ ; le redrive est borne." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=14;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1550" height="55" as="geometry" /></mxCell>

        <mxCell id="outbox" value="OutboxRelay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="exchange" value="Exchange&#xa;securefiles.scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#831843;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="main" value="QUEUE scan&#xa;file.scan.requested" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="retry" value="QUEUE retry&#xa;TTL" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff0e6;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="dlq" value="QUEUE DLQ&#xa;redrive borne" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#be123c;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#881337;" vertex="1" parent="1"><mxGeometry x="650" y="510" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="poison" value="QUEUE poison&#xa;message a analyser" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="650" y="690" width="220" height="100" as="geometry" /></mxCell>

        <mxCell id="listener" value="RabbitMqScanListener&#xa;ACK manuel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="usecase" value="ScanFileUseCase&#xa;MinIO + ClamAV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="230" height="100" as="geometry" /></mxCell>
