<mxfile host="app.diagrams.net" modified="2026-09-18T00:00:00.000Z" agent="SecureFilesAgent" version="1.6.0" type="device">
  <diagram name="Upload file use case" id="upload-file-use-case">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SecureFiles - Upload file use case" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="SecureFiles system boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#475569;fillColor=#f8fafc;verticalAlign=top;align=left;spacingTop=12;spacingLeft=16;fontSize=16;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="900" height="720" as="geometry" />
        </mxCell>

        <mxCell id="actor-user" value="Authenticated user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="actor-storage" value="Quarantine object storage" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1320" y="235" width="140" height="140" as="geometry" />
        </mxCell>
        <mxCell id="actor-database" value="PostgreSQL + Outbox" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1320" y="440" width="140" height="140" as="geometry" />
        </mxCell>
        <mxCell id="actor-queue" value="RabbitMQ scan queue" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1320" y="650" width="140" height="140" as="geometry" />
        </mxCell>

        <mxCell id="uc-upload" value="Upload secure file&#xa;POST /api/v1/files" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="580" y="145" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="uc-validate" value="Validate owner, filename, MIME type&#xa;and declared size" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="370" y="300" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uc-stream" value="Stream bytes to quarantine&#xa;and calculate size + SHA-256" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uc-verify" value="Verify stored size&#xa;and storage version" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="370" y="450" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uc-accept" value="Set PENDING_SCAN&#xa;and record scan request" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uc-response" value="Return 202 Accepted&#xa;with PENDING_SCAN metadata" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=14;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="580" y="610" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uc-reject" value="Reject and cleanup&#xa;REJECTED or upload failure" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="920" y="610" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Post-condition: the upload is complete and queued for asynchronous antivirus scanning.&#xa;CLEAN, INFECTED and SCAN_FAILED belong to the later scan use case.&#xa;UPLOADING is never returned as an accepted upload." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=13;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="350" y="745" width="790" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e-user-upload" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;" edge="1" parent="1" source="actor-user" target="uc-upload">
          <mxGeometry relative="1" as="geometry" />
