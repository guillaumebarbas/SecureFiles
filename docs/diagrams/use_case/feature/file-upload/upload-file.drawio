        <mxCell id="e-accept-database" value="atomic metadata + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="uc-accept" target="actor-database">
