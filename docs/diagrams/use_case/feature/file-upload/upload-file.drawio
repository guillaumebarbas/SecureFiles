        <mxCell id="e-upload-validate" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;strokeColor=#64748b;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="uc-upload" target="uc-validate">
