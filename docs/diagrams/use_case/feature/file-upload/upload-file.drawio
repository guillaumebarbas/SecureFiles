          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-upload-verify" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;strokeColor=#64748b;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="uc-upload" target="uc-verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-upload-accept" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;strokeColor=#64748b;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="uc-upload" target="uc-accept">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-upload-response" value="&lt;&lt;include&gt;&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;strokeColor=#64748b;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="uc-upload" target="uc-response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-reject-validate" value="invalid input / size / storage error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;strokeColor=#dc2626;fontSize=12;fontColor=#991b1b;" edge="1" parent="1" source="uc-reject" target="uc-validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-stream-storage" value="stores and reads metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#334155;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="uc-stream" target="actor-storage">
          <mxGeometry relative="1" as="geometry" />
