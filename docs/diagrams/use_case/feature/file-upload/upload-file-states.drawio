        <mxCell id="note-scope" value="Scope and invariants&#xa;- HTTP validation before a row exists produces no file state.&#xa;- UPLOADING is incomplete: it is not accepted, scannable or downloadable.&#xa;- The controller returns 202 Accepted only after PENDING_SCAN is persisted with FILE_SCAN_REQUESTED." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=13;fontColor=#7c2d12;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="650" height="135" as="geometry" />
        </mxCell>
        <mxCell id="note-maintenance" value="Maintenance boundary&#xa;DELETING is internal and not listable or downloadable. Direct PENDING_SCAN deletion is not shown: the JPA adapter marks CLEAN, INFECTED, SCAN_FAILED or REJECTED as DELETING.&#xa;A failed cleanup remains in DELETING for the reaper." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="790" width="660" height="135" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend: solid arrows = state transition; dashed arrows = retry, rejection or maintenance path. Green = accepted/clean, amber = active scan, red = blocked outcome, blue = transfer, gray = internal maintenance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
